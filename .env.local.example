# Copy this file to .env.local and fill in your Supabase project values
# (Project Settings → API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used to build magic-link redirect URLs when NEXT_PUBLIC not inferable (optional in dev)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense publisher ID (optional — ads are skipped entirely if unset).
# Shown on the landing page and on free-plan creator cards.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
